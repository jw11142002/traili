# SQLite database file (relative to the prisma/ folder)
DATABASE_URL="file:../data/traili.db"

# Public URL of the app (used for invite links and Google OAuth redirect)
APP_URL="http://localhost:3000"

# Optional: Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Where uploaded photos are stored on disk
UPLOAD_DIR="./data/uploads"
