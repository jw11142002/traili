# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase dashboard → Connect → "ORMs" tab → Prisma. Two URLs:
#   DATABASE_URL  = Transaction pooler (port 6543)  — used at runtime
#   DIRECT_URL    = Session pooler     (port 5432)  — used by `prisma db push`
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Photo storage (Supabase Storage) ─────────────────────────────────────────
# Supabase dashboard → Project Settings → API. The bucket is created automatically on first upload.
# Leave both empty to store photos on local disk (dev only; not possible on Vercel).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="photos"
UPLOAD_DIR="./data/uploads"

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL (invite links, Google OAuth redirect, secure cookies)
APP_URL="https://traili.justinyjwang.com"

# Optional: Google sign-in. https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: identifier sent to OpenStreetMap APIs (their usage policy requires one)
OSM_USER_AGENT="traili/0.1 (+https://traili.justinyjwang.com)"
